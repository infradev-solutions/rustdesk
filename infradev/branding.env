# Configuração InfraDev Remote embutida no app.
# A chave abaixo é a PÚBLICA do servidor (server/data/id_ed25519.pub). Pode ficar no repositório.
INFRADEV_HOST=remote.infradevsolutions.com.br
INFRADEV_KEY=9dzORD6JxDS5qOC8omsYO2408R6o42+Hv0gHb0N9Dxg=
# Nome mostrado ao usuário (o nome interno continua "RustDesk", para não quebrar serviços e caminhos).
INFRADEV_APP_NAME="InfraDev Remote"

# Nome interno no Windows: pasta de instalação, atalhos, serviço, .exe e pasta de configuração.
# Só letras, números e hífen (o RustDesk não aceita espaço aqui).
INFRADEV_INTERNAL_NAME=InfraDevRemote
# Fundo do ícone adaptativo do Android
INFRADEV_ICON_BG=#060a14
# Site mostrado nos links "sobre" do app
INFRADEV_SITE=https://infradevsolutions.com.br/
INFRADEV_SITE_LABEL=infradevsolutions.com.br
# Página de download (release "instaladores" do repositório infradev-remote)
INFRADEV_DOWNLOAD=https://github.com/infradev-solutions/infradev-remote/releases/tag/instaladores
